{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/test-results",
      "!**/coverage",
      "!**/pnpm-lock.yaml",
      "!site",
      "!.generated"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "suspicious": {
        "noExplicitAny": "error",
        "noDuplicateParameters": "error",
        "noDoubleEquals": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnreachable": "error"
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
