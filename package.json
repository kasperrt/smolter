{
  "name": "@kasperrt/smolter",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm --parallel --filter \"@smolter/example-*\" dev",
    "fix": "biome check --write .",
    "lint": "biome check . && node scripts/conventions.mjs",
    "typecheck": "pnpm build && tsc --noEmit",
    "test": "pnpm build && vitest run --project unit",
    "coverage": "pnpm build && vitest run --coverage",
    "smoke": "playwright test",
    "size": "pnpm build && node apps/preact/benchmarks/size.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:release": "node scripts/version.mjs release",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "build:examples": "pnpm --filter \"@smolter/example-*\" build",
    "smoke:production": "node scripts/production-smoke.mjs",
    "jsr:check": "node scripts/jsr.mjs",
    "build:site": "pnpm size && pnpm --filter @smolter/example-preact build --mode hosted",
    "smoke:site": "node scripts/site-smoke.mjs",
    "docs:badges": "node scripts/readme-badges.mjs",
    "docs:reference": "pnpm build && node scripts/docs-reference.mjs",
    "docs:check": "pnpm build && node scripts/docs-reference.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@smolter/core": "workspace:*",
    "@smolter/ui": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "version": "0.4.12-beta.1",
  "description": "A tiny typed data router for React and Preact.",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasperrt/smolter.git"
  },
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./preact": {
      "types": "./dist/preact/index.d.ts",
      "import": "./dist/preact/index.js"
    },
    "./react/server": {
      "types": "./dist/server/react.d.ts",
      "import": "./dist/server/react.js"
    },
    "./preact/server": {
      "types": "./dist/server/preact.d.ts",
      "import": "./dist/server/preact.js"
    },
    "./react/client": {
      "types": "./dist/react/client.d.ts",
      "import": "./dist/react/client.js"
    },
    "./preact/client": {
      "types": "./dist/preact/client.d.ts",
      "import": "./dist/preact/client.js"
    },
    "./react/vite": {
      "types": "./dist/vite/react.d.ts",
      "import": "./dist/vite/react.js"
    },
    "./preact/vite": {
      "types": "./dist/vite/preact.d.ts",
      "import": "./dist/vite/preact.js"
    },
    "./utils": {
      "types": "./dist/core/utils.d.ts",
      "import": "./dist/core/utils.js"
    },
    "./utils/http": {
      "types": "./dist/server/node.d.ts",
      "import": "./dist/server/node.js"
    },
    "./utils/assets": {
      "types": "./dist/server/assets.d.ts",
      "import": "./dist/server/assets.js"
    },
    "./utils/responses": {
      "types": "./dist/core/responses.d.ts",
      "import": "./dist/core/responses.js"
    },
    "./preact/lazy-route": {
      "types": "./dist/preact/lazy-route.d.ts",
      "import": "./dist/preact/lazy-route.js"
    },
    "./preact/document": {
      "types": "./dist/preact/document.d.ts",
      "import": "./dist/preact/document.js"
    },
    "./react/document": {
      "types": "./dist/react/document.d.ts",
      "import": "./dist/react/document.js"
    },
    "./react/lazy-route": {
      "types": "./dist/react/lazy-route.d.ts",
      "import": "./dist/react/lazy-route.js"
    }
  },
  "files": [
    "dist",
    ".generated",
    "README.md",
    "LICENSE",
    "jsr.json",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "preact": ">=11.0.1",
    "preact-render-to-string": ">=6.8.1",
    "react": ">=18",
    "vite": ">=8",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "preact-render-to-string": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "author": "Kasper Rynning-Tønnesen <kasperrt@users.noreply.github.com> (https://github.com/kasperrt)",
  "homepage": "https://kasperrt.github.io/smolter/",
  "bugs": {
    "url": "https://github.com/kasperrt/smolter/issues"
  },
  "keywords": [
    "router",
    "react",
    "preact",
    "typescript",
    "loader",
    "action",
    "fetcher",
    "ssr",
    "file-routing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "typescript": "catalog:"
  }
}
