{
  "name": "@kasperrt/smolter",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm --parallel --filter \"@smolter/example-*\" dev",
    "fix": "biome check --write .",
    "lint": "biome check . && node scripts/conventions.ts",
    "typecheck": "pnpm build && tsc --noEmit",
    "test": "pnpm build && vitest run --project unit",
    "coverage": "pnpm build && vitest run --coverage",
    "smoke": "vitest run --config vitest.smoke.config.ts --project integration",
    "size": "pnpm build && node apps/preact/benchmarks/size.ts",
    "check": "pnpm lint && pnpm build && tsc --noEmit && vitest run --project unit",
    "version:patch": "node scripts/version.ts patch",
    "version:minor": "node scripts/version.ts minor",
    "version:prerelease": "node scripts/version.ts prerelease",
    "version:release": "node scripts/version.ts release",
    "pack:smoke": "vitest run --config vitest.smoke.config.ts packed.test.ts",
    "build:examples": "pnpm --filter \"@smolter/example-*\" build",
    "smoke:production": "vitest run --config vitest.smoke.config.ts production.test.ts",
    "jsr:check": "node scripts/jsr.ts",
    "build:site": "pnpm size && pnpm --filter @smolter/example-preact build --mode hosted",
    "smoke:site": "vitest run --config vitest.smoke.config.ts site.test.ts",
    "docs:badges": "node scripts/readme-badges.ts",
    "docs:reference": "pnpm build && node scripts/docs-reference.ts",
    "docs:check": "pnpm build && node scripts/docs-reference.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "preact": "catalog:",
    "preact-render-to-string": "catalog:"
  },
  "version": "0.6.0-alpha.3",
  "description": "A tiny typed data router for React and Preact.",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasperrt/smolter.git"
  },
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./preact": {
      "types": "./dist/preact/index.d.ts",
      "import": "./dist/preact/index.js"
    },
    "./react/server": {
      "types": "./dist/server/react.d.ts",
      "import": "./dist/server/react.js"
    },
    "./preact/server": {
      "types": "./dist/server/preact.d.ts",
      "import": "./dist/server/preact.js"
    },
    "./react/client": {
      "types": "./dist/react/client.d.ts",
      "import": "./dist/react/client.js"
    },
    "./preact/client": {
      "types": "./dist/preact/client.d.ts",
      "import": "./dist/preact/client.js"
    },
    "./react/vite": {
      "types": "./dist/vite/react.d.ts",
      "import": "./dist/vite/react.js"
    },
    "./preact/vite": {
      "types": "./dist/vite/preact.d.ts",
      "import": "./dist/vite/preact.js"
    },
    "./utils": {
      "types": "./dist/core/utils.d.ts",
      "import": "./dist/core/utils.js"
    },
    "./utils/http": {
      "types": "./dist/server/node.d.ts",
      "import": "./dist/server/node.js"
    },
    "./utils/assets": {
      "types": "./dist/server/assets.d.ts",
      "import": "./dist/server/assets.js"
    },
    "./utils/responses": {
      "types": "./dist/core/responses.d.ts",
      "import": "./dist/core/responses.js"
    },
    "./preact/lazy-route": {
      "types": "./dist/preact/lazy-route.d.ts",
      "import": "./dist/preact/lazy-route.js"
    },
    "./preact/document": {
      "types": "./dist/preact/document.d.ts",
      "import": "./dist/preact/document.js"
    },
    "./react/document": {
      "types": "./dist/react/document.d.ts",
      "import": "./dist/react/document.js"
    },
    "./react/lazy-route": {
      "types": "./dist/react/lazy-route.d.ts",
      "import": "./dist/react/lazy-route.js"
    },
    "./react/nested": {
      "types": "./dist/react/nested.d.ts",
      "import": "./dist/react/nested.js"
    },
    "./preact/nested": {
      "types": "./dist/preact/nested.d.ts",
      "import": "./dist/preact/nested.js"
    }
  },
  "files": [
    "dist",
    ".generated",
    "README.md",
    "LICENSE",
    "jsr.json",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "preact": ">=11.0.1",
    "preact-render-to-string": ">=6.8.1",
    "react": ">=18",
    "vite": ">=8",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "preact-render-to-string": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "author": "Kasper Rynning-Tønnesen <kasperrt@users.noreply.github.com> (https://github.com/kasperrt)",
  "homepage": "https://kasperrt.github.io/smolter/",
  "bugs": {
    "url": "https://github.com/kasperrt/smolter/issues"
  },
  "keywords": [
    "router",
    "react",
    "preact",
    "typescript",
    "loader",
    "action",
    "fetcher",
    "ssr",
    "file-routing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "typescript": "catalog:"
  }
}
