{
  "name": "@kasperrt/smolter",
  "version": "0.2.0",
  "exports": {
    "./react": "./src/react.ts",
    "./react/server": "./src/react-server.ts",
    "./preact": "./src/preact.ts",
    "./preact/server": "./src/preact-server.ts",
    "./react/client": "./src/react-client.ts",
    "./preact/client": "./src/preact-client.ts",
    "./utils": "./src/utils.ts"
  },
  "imports": {
    "react": "npm:react@19.3.1",
    "preact/compat": "npm:preact@11.0.1/compat"
  },
  "publish": {
    "include": ["src", "README.md", "LICENSE", "jsr.json"],
    "exclude": [
      "src/vite.ts",
      "src/react-vite.ts",
      "src/preact-vite.ts",
      "src/internal/vite"
    ]
  },
  "license": "MIT",
  "compatibility": {
    "node": ">=22",
    "browser": true
  }
}
