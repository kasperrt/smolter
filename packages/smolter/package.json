{
  "name": "smolter",
  "version": "0.0.1-rc.1",
  "description": "A tiny typed data router for React and Preact.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasperrt/smolter.git",
    "directory": "packages/smolter"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "jsr.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "preact": ">=10.25.0",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "author": "Kasper Rynning-T\u00f8nnesen <kasperrt@users.noreply.github.com> (https://github.com/kasperrt)",
  "homepage": "https://kasperrt.github.io/smolter/",
  "bugs": {
    "url": "https://github.com/kasperrt/smolter/issues"
  },
  "keywords": [
    "router",
    "react",
    "preact",
    "typescript",
    "loader",
    "action",
    "fetcher",
    "ssr",
    "file-routing"
  ],
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
