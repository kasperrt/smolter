{
  "name": "@kasperrt/smolter",
  "version": "0.2.0",
  "description": "A tiny typed data router for React and Preact.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasperrt/smolter.git",
    "directory": "packages/smolter"
  },
  "exports": {
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react/server": {
      "types": "./dist/react-server.d.ts",
      "import": "./dist/react-server.js"
    },
    "./react/vite": {
      "types": "./dist/react-vite.d.ts",
      "import": "./dist/react-vite.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    },
    "./preact/server": {
      "types": "./dist/preact-server.d.ts",
      "import": "./dist/preact-server.js"
    },
    "./preact/vite": {
      "types": "./dist/preact-vite.d.ts",
      "import": "./dist/preact-vite.js"
    },
    "./react/client": {
      "types": "./dist/react-client.d.ts",
      "import": "./dist/react-client.js"
    },
    "./preact/client": {
      "types": "./dist/preact-client.d.ts",
      "import": "./dist/preact-client.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "jsr.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "preact": ">=10.25.0",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "author": "Kasper Rynning-Tønnesen <kasperrt@users.noreply.github.com> (https://github.com/kasperrt)",
  "homepage": "https://kasperrt.github.io/smolter/",
  "bugs": {
    "url": "https://github.com/kasperrt/smolter/issues"
  },
  "keywords": [
    "router",
    "react",
    "preact",
    "typescript",
    "loader",
    "action",
    "fetcher",
    "ssr",
    "file-routing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
