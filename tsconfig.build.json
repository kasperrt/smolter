{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": ".generated",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "paths": {
      "react": ["./packages/react/node_modules/@types/react"],
      "react/*": ["./packages/react/node_modules/@types/react/*"],
      "react-dom": ["./packages/react/node_modules/@types/react-dom"],
      "react-dom/*": ["./packages/react/node_modules/@types/react-dom/*"]
    },
    "emitDeclarationOnly": true
  },
  "include": [".generated/**/*.ts", ".generated/**/*.tsx"],
  "exclude": []
}
