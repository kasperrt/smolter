{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@smolter/core": ["./packages/core/src/index.ts"],
      "@smolter/react": ["./packages/react/src/index.ts"],
      "@smolter/preact": ["./packages/preact/src/index.ts"],
      "@smolter/client": ["./packages/client/src/index.ts"],
      "@smolter/server": ["./packages/server/src/index.ts"],
      "@smolter/files": ["./packages/files/src/index.ts"],
      "@smolter/vite": ["./packages/vite/src/index.ts"],
      "@kasperrt/smolter/react": ["./packages/react/src/index.ts"],
      "@kasperrt/smolter/react/server": ["./packages/server/src/react.ts"],
      "@kasperrt/smolter/react/vite": ["./packages/vite/src/react.ts"],
      "@kasperrt/smolter/preact": ["./packages/preact/src/index.ts"],
      "@kasperrt/smolter/preact/server": ["./packages/server/src/preact.ts"],
      "@kasperrt/smolter/preact/vite": ["./packages/vite/src/preact.ts"],
      "@kasperrt/smolter/react/client": ["./packages/react/src/client.tsx"],
      "@kasperrt/smolter/preact/client": ["./packages/preact/src/client.tsx"],
      "@kasperrt/smolter/utils": ["./packages/core/src/utils.ts"],
      "@kasperrt/smolter/preact/lazy-route": [
        "./packages/preact/src/lazy-route.ts"
      ],
      "@kasperrt/smolter/utils/http": ["./packages/server/src/node.ts"],
      "@kasperrt/smolter/utils/assets": ["./packages/server/src/assets.ts"],
      "@kasperrt/smolter/utils/responses": ["./packages/core/src/responses.ts"],
      "@smolter/core/responses": ["./packages/core/src/responses.ts"],
      "@smolter/preact/router": ["./packages/preact/src/router.tsx"],
      "@smolter/preact/route-types": ["./packages/preact/src/route-types.ts"],
      "@smolter/core/environment": ["./packages/core/src/environment.ts"],
      "@smolter/server/http": ["./packages/server/src/http.ts"],
      "@smolter/core/submission": ["./packages/core/src/submission.ts"],
      "@smolter/core/navigation": ["./packages/core/src/navigation.ts"],
      "@smolter/core/presentation": ["./packages/core/src/presentation.ts"],
      "@smolter/core/transport": ["./packages/core/src/transport.ts"],
      "@smolter/core/intent": ["./packages/core/src/intent.ts"],
      "@smolter/core/prefetch": ["./packages/core/src/prefetch.ts"],
      "@smolter/core/link-prefetch": ["./packages/core/src/link-prefetch.ts"],
      "@smolter/core/viewport": ["./packages/core/src/viewport.ts"],
      "@smolter/core/store": ["./packages/core/src/store.ts"],
      "@kasperrt/smolter/preact/document": [
        "./packages/preact/src/document.tsx"
      ],
      "@smolter/core/url": ["./packages/core/src/url.ts"],
      "@smolter/core/serialize": ["./packages/core/src/serialize.ts"],
      "@smolter/preact/document": ["./packages/preact/src/document.tsx"],
      "@smolter/preact/client": ["./packages/preact/src/client.tsx"],
      "@smolter/core/prepare-routes": ["./packages/core/src/prepare-routes.ts"],
      "@smolter/client/root-data": ["./packages/client/src/root-data.ts"],
      "@smolter/client/hydration": ["./packages/client/src/hydration.ts"],
      "@smolter/client/hash-history": ["./packages/client/src/hash-history.ts"],
      "@smolter/react/router": ["./packages/react/src/router.ts"],
      "@smolter/react/route-types": ["./packages/react/src/route-types.ts"],
      "@kasperrt/smolter/react/document": ["./packages/react/src/document.tsx"],
      "@kasperrt/smolter/react/lazy-route": [
        "./packages/react/src/lazy-route.ts"
      ]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["packages", "apps", "tests", "tooling", "*.ts"],
  "exclude": [".generated", "dist"]
}
