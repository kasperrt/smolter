{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "smolter/core": ["./packages/core/src/index.ts"],
      "@smolter/core": ["./packages/core/src/index.ts"],
      "smolter/react": ["./packages/react/src/index.ts"],
      "@smolter/react": ["./packages/react/src/index.ts"],
      "smolter/preact": ["./packages/preact/src/index.ts"],
      "@smolter/preact": ["./packages/preact/src/index.ts"],
      "smolter/client": ["./packages/client/src/index.ts"],
      "@smolter/client": ["./packages/client/src/index.ts"],
      "smolter/server": ["./packages/server/src/index.ts"],
      "@smolter/server": ["./packages/server/src/index.ts"],
      "smolter/files": ["./packages/files/src/index.ts"],
      "@smolter/files": ["./packages/files/src/index.ts"],
      "smolter/vite": ["./packages/vite/src/index.ts"],
      "@smolter/vite": ["./packages/vite/src/index.ts"],
      "smolter": ["./packages/core/src/index.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["packages", "apps", "tests", "*.ts"],
  "exclude": [
    "packages/smolter/src/internal",
    "packages/smolter/src",
    "packages/smolter/dist"
  ]
}
