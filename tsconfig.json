{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "smolter": ["./packages/smolter/src/react.ts"],
      "smolter/core": ["./packages/smolter/src/core.ts"],
      "smolter/preact": ["./packages/smolter/src/preact.ts"],
      "smolter/server": ["./packages/smolter/src/server.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["packages", "apps", "tests", "*.ts"]
}
